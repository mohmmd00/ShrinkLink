@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4">
    <!-- Main Feature Card -->
    <div class="col-lg-12 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <h1 class="display-5 fw-bold mb-4">
                    Transform Links into <span class="text-primary">Growth Engines</span>
                </h1>

                <p class="lead text-muted mb-5">
                    ShrinkLink turns messy URLs into clean, trackable links that look professional and drive 34% more clicks. Trusted by 15,000+ marketers worldwide.
                </p>

                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card border-0 bg-light rounded-3 h-100 shadow-sm">
                            <div class="card-body text-center p-4">
                                <div class="bg-primary bg-opacity-10 rounded-circle p-3 mx-auto mb-3 d-inline-flex" style="width: 80px; height: 80px;">
                                    <iconify-icon icon="solar:rocket-linear" class="fs-8 text-primary mx-auto my-auto"></iconify-icon>
                                </div>
                                <h4 class="fw-bold mb-2">Boost Engagement</h4>
                                <p class="text-muted mb-0">Clean links get 34% more clicks and improve brand perception</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 bg-light rounded-3 h-100 shadow-sm">
                            <div class="card-body text-center p-4">
                                <div class="bg-primary bg-opacity-10 rounded-circle p-3 mx-auto mb-3 d-inline-flex" style="width: 80px; height: 80px;">
                                    <iconify-icon icon="solar:graph-up-bold" class="fs-8 text-primary mx-auto my-auto"></iconify-icon>
                                </div>
                                <h4 class="fw-bold mb-2">Real-time Analytics</h4>
                                <p class="text-muted mb-0">Track clicks, locations, devices, and campaign performance</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 bg-light rounded-3 h-100 shadow-sm">
                            <div class="card-body text-center p-4">
                                <div class="bg-primary bg-opacity-10 rounded-circle p-3 mx-auto mb-3 d-inline-flex" style="width: 80px; height: 80px;">
                                    <iconify-icon icon="solar:shield-check-bold" class="fs-8 text-primary mx-auto my-auto"></iconify-icon>
                                </div>
                                <h4 class="fw-bold mb-2">Enterprise Security</h4>
                                <p class="text-muted mb-0">SSL encryption, malware scanning, and link expiration</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-4 border-top border-light">
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <span class="badge bg-light text-dark py-2 px-3">
                            <iconify-icon icon="solar:verified-check-bold" class="me-1"></iconify-icon>
                            98.7% Uptime Guarantee
                        </span>
                        <span class="badge bg-light text-dark py-2 px-3">
                            <iconify-icon icon="solar:support-bold" class="me-1"></iconify-icon>
                            24/7 Support
                        </span>
                        <span class="badge bg-light text-dark py-2 px-3">
                            <iconify-icon icon="solar:document-bold" class="me-1"></iconify-icon>
                            GDPR Compliant
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- کارت حرفه‌ای با استفاده انحصاری از کلاس‌های Bootstrap -->
    <div class="col-lg-6 mb-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4 p-md-5 d-flex flex-column">
                <div class="mb-4">
                    <h2 class="fw-bold display-6 mb-2">Start Growing Today</h2>
                    <p class="text-muted mb-0">
                        Transform your links in seconds and unlock powerful analytics
                    </p>
                </div>

                <div class="d-grid gap-3 flex-grow-1">
                    <a asp-controller="Dashboard" asp-action="Links"
                       class="btn btn-primary btn-lg py-3 fw-bold d-flex align-items-center justify-content-center position-relative">
                        <span>Create Short Link</span>
                        <iconify-icon icon="solar:link-bold" class="ms-2 fs-5"></iconify-icon>
                    </a>

                    <a asp-controller="Dashboard" asp-action="Analyze"
                       class="btn btn-outline-primary btn-lg py-3 fw-bold d-flex align-items-center justify-content-center border-2">
                        <span>Analyze Links</span>
                        <iconify-icon icon="solar:chart-2-bold" class="ms-2 fs-5"></iconify-icon>
                    </a>
                </div>

                <div class="mt-4 pt-3 border-top border-light">
                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <div class="d-flex align-items-center text-muted">
                            <iconify-icon icon="solar:verified-check-bold" class="me-2 fs-5 text-primary"></iconify-icon>
                            <small>Free forever</small>
                        </div>
                        <div class="d-flex align-items-center text-muted">
                            <iconify-icon icon="solar:credit-card-bold" class="me-2 fs-5 text-primary"></iconify-icon>
                            <small>No credit card required</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ستون راست: بهینه‌سازی شده -->
    <div class="col-lg-6 mb-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center mb-4">
                    <h2 class="h4 fw-bold mb-0">Popular Use Cases</h2>
                </div>

                <!-- Social Media Section -->
                <div class="mb-4">
                    <h3 class="h5 fw-bold mb-3 d-flex align-items-center">
                        <iconify-icon icon="solar:hashtag-linear" class="me-2 fs-5 text-primary"></iconify-icon>
                        Social Media Links
                    </h3>
                    <p class="text-muted mb-0">
                        Shorten links for Twitter, Instagram, and Facebook to save character space and track engagement.
                    </p>
                </div>

                <!-- Email Marketing Section -->
                <div class="mb-4">
                    <h3 class="h5 fw-bold mb-3 d-flex align-items-center">
                        <iconify-icon icon="solar:letter-bold" class="me-2 fs-5 text-success"></iconify-icon>
                        Email Campaigns
                    </h3>
                    <p class="text-muted mb-0">
                        Create trackable links in your newsletters to see which content resonates with your audience.
                    </p>
                </div>

                <!-- Enterprise Security Section -->
                <div class="mb-4">
                    <h3 class="h5 fw-bold mb-3 d-flex align-items-center">
                        <iconify-icon icon="solar:shield-check-bold" class="me-2 fs-5 text-success"></iconify-icon>
                        Enterprise Security
                    </h3>
                    <p class="text-muted mb-0">
                        SSL encryption, malware scanning, and link expiration.
                    </p>
                </div>

                <!-- Global Performance Section -->
                <div class="mb-0">
                    <h3 class="h5 fw-bold mb-3 d-flex align-items-center">
                        <iconify-icon icon="solar:globe-linear" class="me-2 fs-5 text-primary"></iconify-icon>
                        Global Performance
                    </h3>
                    <p class="text-muted mb-0">
                        Our globally distributed infrastructure ensures your shortened links resolve quickly from anywhere in the world.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>