@model ShrinkLink.Contracts.DataTransferObjects.AuthorizationService.LoginRequestTransferObject
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "LoginPage";
}
<div class="position-relative overflow-hidden min-vh-100 d-flex align-items-center justify-content-center">
    <div class="d-flex align-items-center justify-content-center w-100">
        <div class="row justify-content-center w-100">
            <div class="col-md-8 col-lg-6 col-xxl-3">
                <div class="card mb-0">
                    <div class="card-body">
                        <a asp-controller="Home" asp-action="index" class="text-nowrap logo-img text-center d-block py-3 w-100">
                            <img src="../assets/images/logos/logo01.svg" alt="" width="144px" height="43px" />
                        </a>
                        <p class="text-center">Your Social Campaigns</p>

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger" role="alert">
                                @ViewBag.ErrorMessage
                            </div>
                        }
                        @if (TempData["RegisterResponse"] != null)
                        {
                            <div class="alert alert-success" role="alert">
                                @TempData["RegisterResponse"]
                            </div>
                        }

                        <form method="post" asp-controller="Account" asp-action="Login">
                            <div class="mb-3">
                                <label asp-for="Username" class="form-label">Username</label>
                                <input asp-for ="Username" type="text" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
                            </div>
                            <div class="mb-4">
                                <label asp-for="Password" class="form-label">Password</label>
                                <input asp-for="Password" type="password" class="form-control" id="exampleInputPassword1">
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <div class="form-check">
                                    <input class="form-check-input primary" type="checkbox" value="" id="flexCheckChecked" checked>
                                    <label class="form-check-label text-dark" for="flexCheckChecked">
                                        Remember this Device
                                    </label>
                                </div>
                                <a class="text-primary fw-bold" href="./index.html">Forgot Password ?</a>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-8 fs-4 mb-4" asp-controller="Account" asp-action="Login">Sign In</button>
                            <div class="d-flex align-items-center justify-content-center">
                                <p class="fs-4 mb-0 fw-bold">New to ShrinkLink?</p>
                                <a class="text-primary fw-bold ms-2" asp-controller="Account" asp-action="RegisterPage">Create an account</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>