@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const analysisData = @Html.Raw(Json.Serialize(Model?.AnalyzeViewModel?.AnalysisData));

            const chartConfigs = {
                bar: {
                    chart: {
                        type: 'bar',
                        height: 350,
                        toolbar: { show: false },
                        zoom: { enabled: false },
                        animations: { enabled: true, easing: 'easeinout', speed: 800 }
                    },
                    plotOptions: {
                        bar: { borderRadius: 4, columnWidth: '50%', distributed: false }
                    },
                    dataLabels: { enabled: false },
                    grid: { borderColor: '#f1f1f1', strokeDashArray: 4 },
                    xaxis: {
                        labels: { rotate: -45, style: { fontSize: '12px' } }
                    },
                    yaxis: {
                        labels: {
                            formatter: function (val) { return Math.round(val); }
                        }
                    },
                    tooltip: {
                        theme: 'light',
                        y: { formatter: function (val) { return `${val} visit${val !== 1 ? 's' : ''}`; } }
                    }
                },
                pie: {
                    chart: {
                        type: 'pie',
                        height: 350,
                        toolbar: { show: false },
                        animations: { enabled: true, easing: 'easeinout', speed: 800 }
                    },
                    labels: [],
                    legend: { position: 'bottom', offsetY: 5 },
                    tooltip: {
                        theme: 'light',
                        y: {
                            formatter: function (val, { series, seriesIndex, dataPointIndex, w }) {
                                return `${val}% (${series[seriesIndex][dataPointIndex]})`;
                            }
                        }
                    },
                    dataLabels: {
                        enabled: true,
                        formatter: function (val) { return val > 5 ? `${val.toFixed(1)}%` : ''; }
                    }
                },
                horizontalBar: {
                    chart: {
                        type: 'bar',
                        height: 350,
                        toolbar: { show: false },
                        animations: { enabled: true, easing: 'easeinout', speed: 800 }
                    },
                    plotOptions: {
                        bar: { horizontal: true, borderRadius: 4, distributed: false }
                    },
                    dataLabels: { enabled: false },
                    grid: { borderColor: '#f1f1f1', strokeDashArray: 4 },
                    xaxis: {
                        labels: {
                            style: { fontSize: '12px' },
                            formatter: function (val) { return Math.round(val); }
                        }
                    },
                    yaxis: {
                        labels: {
                            style: { fontSize: '12px' }
                        }
                    },
                    tooltip: { theme: 'light' }
                }
            };

            function renderChart(selector, config, emptyMessage) {
                const element = document.querySelector(selector);
                if (!element) return;
                element.innerHTML = '';
                if (!analysisData || Object.keys(analysisData).length === 0) {
                    element.innerHTML = `
                                <div class="d-flex flex-column align-items-center justify-content-center h-100">
                                    <i class="ti ti-chart-off fs-2 text-muted mb-2"></i>
                                    <p class="text-muted mb-0">${emptyMessage}</p>
                                </div>`;
                    return;
                }
                try {
                    new ApexCharts(element, config).render();
                } catch (error) {
                    console.error(`Error rendering chart ${selector}:`, error);
                    element.innerHTML = `
                                <div class="d-flex flex-column align-items-center justify-content-center h-100">
                                    <i class="ti ti-alert-circle fs-2 text-danger mb-2"></i>
                                    <p class="text-danger mb-0">Error loading chart</p>
                                </div>`;
                }
            }

            if (analysisData) {
                // Visits by Hour
                if (analysisData.trafficByHour && Object.keys(analysisData.trafficByHour).length > 0) {
                    renderChart('#bar-chart', {
                        ...chartConfigs.bar,
                        series: [{ name: 'Visits', data: Object.values(analysisData.trafficByHour) }],
                        xaxis: { categories: Object.keys(analysisData.trafficByHour) }
                    }, 'No traffic data recorded yet');
                } else {
                    document.querySelector('#bar-chart').innerHTML = `
                                <div class="d-flex flex-column align-items-center justify-content-center h-100">
                                    <i class="ti ti-chart-line fs-2 text-muted mb-2"></i>
                                    <p class="text-muted mb-0">No traffic data recorded yet</p>
                                </div>`;
                }

                // Top Countries
                if (Object.keys(analysisData.topCountries || {}).length > 0) {
                    renderChart('#country-chart', {
                        ...chartConfigs.pie,
                        series: Object.values(analysisData.topCountries),
                        labels: Object.keys(analysisData.topCountries)
                    }, 'No country data recorded yet');
                } else {
                    document.querySelector('#country-chart').innerHTML = `
                                <div class="d-flex flex-column align-items-center justify-content-center h-100">
                                    <i class="ti ti-world fs-2 text-muted mb-2"></i>
                                    <p class="text-muted mb-0">No country data recorded yet</p>
                                </div>`;
                }

                // Top Cities
                if (Object.keys(analysisData.topCities || {}).length > 0) {
                    renderChart('#city-chart', {
                        ...chartConfigs.pie,
                        series: Object.values(analysisData.topCities),
                        labels: Object.keys(analysisData.topCities)
                    }, 'No city data recorded yet');
                } else {
                    document.querySelector('#city-chart').innerHTML = `
                                <div class="d-flex flex-column align-items-center justify-content-center h-100">
                                    <i class="ti ti-building fs-2 text-muted mb-2"></i>
                                    <p class="text-muted mb-0">No city data recorded yet</p>
                                </div>`;
                }

                // Device Types
                if (Object.keys(analysisData.topDeviceTypes || {}).length > 0) {
                    renderChart('#device-chart', {
                        ...chartConfigs.pie,
                        series: Object.values(analysisData.topDeviceTypes),
                        labels: Object.keys(analysisData.topDeviceTypes)
                    }, 'No device data recorded yet');
                } else {
                    document.querySelector('#device-chart').innerHTML = `
                                <div class="d-flex flex-column align-items-center justify-content-center h-100">
                                    <i class="ti ti-device-laptop fs-2 text-muted mb-2"></i>
                                    <p class="text-muted mb-0">No device data recorded yet</p>
                                </div>`;
                }

                // Browsers
                if (Object.keys(analysisData.topBrowsers || {}).length > 0) {
                    renderChart('#browser-chart', {
                        ...chartConfigs.bar,
                        series: [{ name: 'Visits', data: Object.values(analysisData.topBrowsers) }],
                        xaxis: { categories: Object.keys(analysisData.topBrowsers) }
                    }, 'No browser data recorded yet');
                } else {
                    document.querySelector('#browser-chart').innerHTML = `
                                <div class="d-flex flex-column align-items-center justify-content-center h-100">
                                    <i class="ti ti-browser fs-2 text-muted mb-2"></i>
                                    <p class="text-muted mb-0">No browser data recorded yet</p>
                                </div>`;
                }

                // ✅ Operating Systems - Fixed!
                if (Object.keys(analysisData.topOperatingSystems || {}).length > 0) {
                    renderChart('#os-chart', {
                        ...chartConfigs.horizontalBar,
                        series: [{ name: 'Visits', data: Object.values(analysisData.topOperatingSystems) }],
                        xaxis: {
                            categories: Object.keys(analysisData.topOperatingSystems),
                            labels: { formatter: function (val) { return Math.round(val); } }
                        },
                        yaxis: {
                            labels: { style: { fontSize: '12px' } }
                        }
                    }, 'No OS data recorded yet');
                } else {
                    document.querySelector('#os-chart').innerHTML = `
                                <div class="d-flex flex-column align-items-center justify-content-center h-100">
                                    <i class="ti ti-brand-windows fs-2 text-muted mb-2"></i>
                                    <p class="text-muted mb-0">No OS data recorded yet</p>
                                </div>`;
                }

                // Country Percentages
                if (Object.keys(analysisData.countryVisitPercentages || {}).length > 0) {
                    renderChart('#country-percent-chart', {
                        ...chartConfigs.pie,
                        series: Object.values(analysisData.countryVisitPercentages),
                        labels: Object.keys(analysisData.countryVisitPercentages)
                    }, 'No country percentage data recorded yet');
                } else {
                    document.querySelector('#country-percent-chart').innerHTML = `
                                <div class="d-flex flex-column align-items-center justify-content-center h-100">
                                    <i class="ti ti-percentage fs-2 text-muted mb-2"></i>
                                    <p class="text-muted mb-0">No country percentage data recorded yet</p>
                                </div>`;
                }
            }
        });
    </script>
}