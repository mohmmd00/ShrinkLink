@model ShrinkLink.WebApp.Models.Dtos.RegisterModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "RegisterPage";
}
<div class="position-relative overflow-hidden min-vh-100 d-flex align-items-center justify-content-center">
    <div class="d-flex align-items-center justify-content-center w-100">
        <div class="row justify-content-center w-100">
            <div class="col-md-8 col-lg-6 col-xxl-3">
                <div class="card mb-0">
                    <div class="card-body">
                        <a asp-controller="Home" asp-action="Index" class="text-nowrap logo-img text-center d-block py-3 w-100">
                            <img src="../assets/images/logos/logo-light.svg" alt="">
                        </a>
                        <p class="text-center">Your Social Campaigns</p>
                        <form method="post">
                            <div class="mb-3">
                                <label asp-for="TransferObject" class="form-label">Username</label>
                                <input asp-for="TransferObject.Username" type="text" class="form-control" id="exampleInputtext1" aria-describedby="textHelp">
                            </div>
                            <div class="mb-3">
                                <label asp-for="TransferObject" class="form-label">Email Address</label>
                                <input asp-for="TransferObject.Email" type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
                            </div>
                            <div class="mb-4">
                                <label asp-for="TransferObject" class="form-label">Password</label>
                                <input asp-for="TransferObject.Password" type="password" class="form-control" id="exampleInputPassword1">
                            </div>
                            <button asp-controller="Home" asp-action="Register" class="btn btn-primary w-100 py-8 fs-4 mb-4">Sign Up</button>
                            <div class="d-flex align-items-center justify-content-center">
                                <p class="fs-4 mb-0 fw-bold">Already have an Account?</p>
                                <a class="text-primary fw-bold ms-2" asp-controller="Home" asp-action="LoginPage">Sign In</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
