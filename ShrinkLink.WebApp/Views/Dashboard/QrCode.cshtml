@model ShrinkLink.WebApp.Models.DashBoardBindingModels.QRCodeModel
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using ShrinkLink.Contracts.DataTransferObjects.QrCodeService
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "QR Code Generator";
}

<div class="row g-4">
    <!-- QR Code Generator Form -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4 p-md-5">
                <header class="mb-4 text-center">
                    <h1 class="h3 fw-bold mb-2">Generate QR Code</h1>
                    <p class="text-muted mb-0">Create secure QR codes for digital identity verification</p>
                </header>

                <form asp-controller="Dashboard" asp-action="GenerateQrCode" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label for="qrInputCode" class="form-label fw-semibold">
                            Short Code <span class="text-danger">*</span>
                        </label>
                        <div class="input-group has-validation">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="ti ti-hash text-primary" aria-hidden="true"></i>
                            </span>
                            <input asp-for="QrCodeGenerateRequest.Code"
                                   class="form-control form-control-lg border-start-0"
                                   id="qrInputCode"
                                   placeholder="Enter 7-character code"
                                   maxlength="7"
                                   required
                                   aria-describedby="codeHelp"
                                   autofocus>
                        </div>
                        <div id="codeHelp" class="form-text mt-2">
                            <i class="ti ti-info-circle text-primary me-1"></i>
                            Use exactly 7 alphanumeric characters (A-Z, 0-9)
                        </div>
                        <span asp-validation-for="QrCodeGenerateRequest.Code" class="text-danger small d-block mt-1"></span>
                    </div>

                    <button type="submit" class="btn btn-lg btn-primary w-100 py-3 fw-semibold">
                        <i class="ti ti-qrcode me-2"></i> Generate Secure QR Code
                    </button>

                    <div class="mt-3 text-center">
                        <a href="/dashboard" class="link-primary small">
                            <i class="ti ti-arrow-left me-1"></i> Back to Dashboard
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- QR Code Display Section -->
        @if (Model.QrCode != null)
        {
            if (Model.QrCode.Status == QrCodeGenerateStatus.Success &&
            !string.IsNullOrEmpty(Model.QrCode.QrCodeBase64))
            {
                <!-- QR Code Display - Only show when we have valid data -->
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <header class="mb-4 text-center">
                            <h2 class="h4 fw-bold mb-2 text-primary">Your QR Code</h2>
                            <p class="text-muted mb-0">Scan to access your digital identity verification</p>
                        </header>

                        <div class="d-flex flex-column align-items-center">
                            <!-- QR Code -->
                            <div class="position-relative mb-4" style="width: 300px; height: 300px;">
                                <div class="rounded-3 overflow-hidden shadow-sm border border-2 border-primary border-opacity-10" style="width: 100%; height: 100%;">
                                    <img class="img-fluid w-100 h-100"
                                         src="data:image/png;base64,@Model.QrCode.QrCodeBase64"
                                         alt="QR code for digital identity verification"
                                         loading="lazy">
                                </div>
                            </div>
                            
                            <!--Copy Base64-->
                            <div class="mb-2 text-center">
                                <p class="text-muted">You can access base64 by right click and copy image link button </p>
                            </div>

                            <!-- Download Button -->
                            <a href="data:image/png;base64,@Model.QrCode.QrCodeBase64"
                               download="shrinklink-qrcode-@(Model.QrCodeGenerateRequest?.Code ?? "unknown").png"
                               class="btn btn-lg btn-primary w-100 py-3 fw-semibold mb-4">
                                <i class="ti ti-download me-2"></i> Download QR Code
                            </a>
                        </div>
                    </div>
                </div>
            }
            else if (Model.QrCode.Status != QrCodeGenerateStatus.Success)
            {
                <!-- Show specific error message based on status -->
                <div class="alert alert-danger mb-4">
                    <h4 class="alert-heading">QR Code Generation Failed</h4>
                    <p>
                        @switch (Model.QrCode.Status)
                        {
                            case QrCodeGenerateStatus.InvalidInput:
                                <text>The code you entered is invalid. Please use exactly 7 alphanumeric characters.</text>
                                break;
                            case QrCodeGenerateStatus.Failed:
                                <text>No link found for the provided code. Please check your short code and try again.</text>
                                break;
                            default:
                                <text>QR code generation failed with status: @Model.QrCode.Status</text>
                                break;
                        }
                    </p>
                    <hr>
                    <p class="mb-0">Please try again with a different code or contact support if the issue persists.</p>
                </div>
            }
            else
            {
                <!-- QR code was generated but contains no data -->
                <div class="alert alert-warning mb-4">
                    <h4 class="alert-heading">Empty QR Code</h4>
                    <p>The QR code was generated but contains no data. This may indicate an issue with the generation process.</p>
                </div>
            }
        }
        else
        {
            <!-- No QR code object at all - likely initial page load -->
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="ti ti-qrcode fs-3 text-muted"></i>
                </div>
                <h3 class="h5 fw-bold mb-2">No QR Code Generated Yet</h3>
                <p class="text-muted mb-0">Enter a short code above and click "Generate Secure QR Code" to create your QR code</p>
            </div>
        }

        
    </div>

    <!-- QR Code Display & Shortened Links -->
    <div class="col-lg-6">
        <!-- QR Code Instructions -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="me-3 p-2 bg-primary bg-opacity-10 rounded">
                        <i class="ti ti-info-circle text-primary fs-4"></i>
                    </div>
                    <h2 class="h5 fw-bold mb-0">How to Use QR Codes</h2>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex align-items-start">
                        <i class="ti ti-circle-check text-success me-2 mt-1"></i>
                        <div>
                            <strong>Security Verification</strong>
                            <p class="text-muted mb-0">Use QR codes for secure identity verification processes</p>
                        </div>
                    </li>
                    <li class="list-group-item d-flex align-items-start">
                        <i class="ti ti-circle-check text-success me-2 mt-1"></i>
                        <div>
                            <strong>Marketing Campaigns</strong>
                            <p class="text-muted mb-0">Include in print materials to drive traffic to your content</p>
                        </div>
                    </li>
                    <li class="list-group-item d-flex align-items-start">
                        <i class="ti ti-circle-check text-success me-2 mt-1"></i>
                        <div>
                            <strong>Event Management</strong>
                            <p class="text-muted mb-0">Use for check-in systems and access control at events</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Shortened Links Table with Scrollable Container -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="h5 fw-bold mb-1 d-flex align-items-center">
                            <i class="ti ti-link me-2 text-primary"></i>
                            Your Shortened Links
                        </h2>
                        <p class="text-muted mb-0">Manage your shortened URLs</p>
                    </div>
                    @if (Model.LinksViewModel?.LinksToViewModel.Count > 0)
                    {
                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                            @Model.LinksViewModel.LinksToViewModel.Count total links
                        </span>
                    }
                </div>

                @if (Model.LinksViewModel?.LinksToViewModel != null && Model.LinksViewModel.LinksToViewModel.Any())
                {
                    <div class="table-responsive" style="max-height: 640px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                            <tr>
                                <th scope="col" class="ps-2">Original URL</th>
                                <th scope="col" class="text-center">Code</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var link in Model.LinksViewModel.LinksToViewModel)
                            {
                                <tr>
                                    <!-- Long URL -->
                                    <td class="ps-0">
                                        <div class="d-flex align-items-center">
                                            <div class="me-2 p-2 text-center" style="width: 32px; height: 32px;">
                                                <i class="ti ti-world text-primary"></i>
                                            </div>
                                            <a href="@link.OriginalUrl" target="_blank" class="text-decoration-none text-dark fw-medium d-block text-truncate" style="max-width: 250px;" title="@link.OriginalUrl">
                                                @(link.OriginalUrl.Length > 40
                                                    ? link.OriginalUrl.Substring(0, 40) + "..."
                                                    : link.OriginalUrl)
                                            </a>
                                        </div>
                                    </td>

                                    <!-- Code -->
                                    <td class="text-center">
                                        <span class="d-inline-block bg-light px-2 py-1 rounded fw-medium text-primary">@link.Code</span>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <div class="mb-3">
                            <i class="ti ti-link-off fs-1 text-muted"></i>
                        </div>
                        <h3 class="h6 fw-bold mb-1">No Shortened Links Found</h3>
                        <p class="text-muted mb-0">Create your first shortened link from the dashboard</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Copy Base64 functionality
            const copyBase64Btn = document.getElementById('copyBase64Btn');
            const qrCodeBase64 = @(Model.QrCode != null && !string.IsNullOrEmpty(Model.QrCode.QrCodeBase64) ? $"`{Model.QrCode.QrCodeBase64}`" : "null");

            if (copyBase64Btn && qrCodeBase64) {
                copyBase64Btn.addEventListener('click', function () {
                    navigator.clipboard.writeText(qrCodeBase64).then(() => {
                        // Change button appearance temporarily
                        const originalText = this.innerHTML;
                        this.innerHTML = '<i class="ti ti-check me-1"></i> Copied!';
                        this.classList.remove('btn-outline-secondary');
                        this.classList.add('btn-success');

                        // Revert after 2 seconds
                        setTimeout(() => {
                            this.innerHTML = originalText;
                            this.classList.remove('btn-success');
                            this.classList.add('btn-outline-secondary');
                        }, 2000);
                    }).catch(err => {
                        console.error('Failed to copy: ', err);
                        alert('Failed to copy Base64 data. Please try again.');
                    });
                });
            }
        });
    </script>
}