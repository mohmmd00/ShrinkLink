@using Microsoft.AspNetCore.Mvc.TagHelpers
@using ShrinkLink.Contracts.DataTransferObjects.AnalyzeService
@model ShrinkLink.WebApp.Models.DashBoardBindingModels.AnalyzeSingleLinkModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Link Analytics";
}

<!-- Error Alert -->
@if (TempData["AnalysisVisitsErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="ti ti-alert-circle me-2 fs-4"></i>
            <div>
                <h5 class="alert-heading mb-1">Analysis Error</h5>
                <p class="mb-0">@TempData["AnalysisVisitsErrorMessage"]</p>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* <!-- Link Header -->
@if (Model?.AnalyzeViewModel != null && Model.AnalyzeViewModel.Status == VisitAnalysisReportStatus.Success)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center">
                    <div class="me-3 p-2 bg-primary bg-opacity-10 rounded">
                        <i class="ti ti-link fs-2 text-primary"></i>
                    </div>
                    <div>
                        <h1 class="h3 fw-bold mb-1">@Model.AnalyzeViewModel.</h1>
                        <p class="text-muted mb-0">
                            Analyzing link created on @DateTime.Parse(Model.AnalyzeViewModel.CreatedAt).ToString("MMM dd, yyyy")
                        </p>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="@Model.AnalyzeViewModel.OriginalUrl" target="_blank" class="btn btn-outline-secondary" rel="noopener noreferrer">
                        <i class="ti ti-external-link me-1"></i> Visit Original
                    </a>
                    <a href="/dashboard" class="btn btn-primary">
                        <i class="ti ti-arrow-left me-1"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
}
 *@
<!-- Summary Section -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <header class="mb-4 text-center">
            <h2 class="h4 fw-bold mb-2 d-flex justify-content-center align-items-center gap-2">
                <i class="ti ti-chart-bar fs-4 text-primary"></i>
                Link Performance Summary
            </h2>
            <p class="text-muted mb-0">Key metrics for your shortened link</p>
        </header>

        <div class="row g-3">
            @{
                var summaryItems = new[] {
            new { Label = "Total Visits", Value = "0", Icon = "ti-users", Description = "Total number of visits to this link" },
            new { Label = "Unique Countries", Value = "0", Icon = "ti-world", Description = "Countries where this link was accessed" },
            new { Label = "Unique Cities", Value = "0", Icon = "ti-building", Description = "Cities where this link was accessed" },
            new { Label = "Peak Hour", Value = "-", Icon = "ti-clock", Description = "Hour with highest traffic" },
            new { Label = "Avg Visits/Hour", Value = "0.00", Icon = "ti-chart-line", Description = "Average visits per hour" }
            };

                if (Model?.AnalyzeViewModel != null &&
                Model.AnalyzeViewModel.Status == VisitAnalysisReportStatus.Success &&
                Model.AnalyzeViewModel.AnalysisData != null)
                {
                    var data = Model.AnalyzeViewModel.AnalysisData;
                    summaryItems = new[] {
            new { Label = "Total Visits", Value = data.TotalVisits.ToString("N0"), Icon = "ti-users", Description = "Total number of visits to this link" },
            new { Label = "Unique Countries", Value = data.UniqueCountries.ToString(), Icon = "ti-world", Description = "Countries where this link was accessed" },
            new { Label = "Unique Cities", Value = data.UniqueCities.ToString(), Icon = "ti-building", Description = "Cities where this link was accessed" },
            new { Label = "Peak Hour", Value = data.PeakHour, Icon = "ti-clock", Description = "Hour with highest traffic" },
            new { Label = "Avg Visits/Hour", Value = data.AverageVisitsPerHour.ToString("F2"), Icon = "ti-chart-line", Description = "Average visits per hour" }
            };
                }
            }

            @foreach (var item in summaryItems)
            {
                <div class="col-6 col-md-4 col-lg-2" title="@item.Description">
                    <div class="card h-100 border-0 bg-light bg-opacity-10 shadow-sm rounded-3">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center mb-2">
                                <i class="@item.Icon text-primary fs-4 me-2"></i>
                                <h6 class="text-muted mb-0 fw-normal">@item.Label</h6>
                            </div>
                            <h3 class="fw-bold mb-0 text-truncate" style="max-width: 100px;">@item.Value</h3>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

